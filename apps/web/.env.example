# 관리자 접속 키 — /admin7 로그인에 사용. 없으면 프로덕션에서 관리자 경로 전체가 404. 로컬 개발에서 비우면 "dev"
ADMIN_ACCESS_KEY=

# ── 소셜 로그인 (Auth.js) ──
# openssl rand -base64 32
AUTH_SECRET=
# 네이버 개발자센터 > 애플리케이션 > Client ID / Secret · 콜백 URL: {ORIGIN}/api/auth/callback/naver
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
# 카카오 디벨로퍼스 > 앱 키 > REST API 키 · 보안 > Client Secret (활성화) · Redirect URI: {ORIGIN}/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# 1이면 소셜 키가 있어도 데모 로그인 노출 (기본: 키 없을 때만 노출)
NEXT_PUBLIC_DEMO_LOGIN=

# ── Supabase (프로젝트 생성 후 채움) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 관리자 API 전용(서버만) — 절대 NEXT_PUBLIC 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=
