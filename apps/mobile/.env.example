# Expo 는 EXPO_PUBLIC_ 접두사 변수만 앱 번들에 노출한다
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 로그인: Supabase 대시보드에서 Kakao 제공자를 켜고(REST API 키·Client Secret), Redirect URLs 에
# jubutech://auth/callback 과 exp://127.0.0.1:8081/--/auth/callback 을 등록한다. 절차는 docs/KAKAO-LOGIN-setup.md

# 초대 공유 글에 붙일 랜딩 주소 (예: https://jubutech.vercel.app). 비우면 코드만 보낸다
EXPO_PUBLIC_WEB_URL=
